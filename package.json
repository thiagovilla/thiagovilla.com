    "gatsby-source-dropbox": "^0.2.3",
    "gatsby-source-filesystem": "^4.25.0",
    "gatsby-source-google-docs": "^2.3.0",
    "gatsby-source-graphcms": "^2.8.0",
    "gatsby-transformer-remark": "^5.25.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remark-autolink-headings": "^6.1.0",
    "remark-footnotes": "^3.0.0",
    "remark-gfm": "^1.0.0",
    "remark-prism": "^1.3.6",
    "remark-slug": "^6.1.0"
  },
  "devDependencies": {
    "dotenv": "^16.0.3"
