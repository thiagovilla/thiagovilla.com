{
  "name": "thiago-villa",
  "version": "1.0.0",
  "private": true,
  "description": "thiago-villa",
  "keywords": [
    "gatsby"
  ],
  "scripts": {
    "develop": "DROPBOX_ACCESS_TOKEN=$(./get-dbx-at.sh) && gatsby develop",
